# Written by `npx create-alopex` as it goes; you don't need to fill it in by hand. The Edge
# Functions read their own copies as secrets (see supabase/functions/README.md).

# Where the sync runs: supabase (pg_cron). Written by the installer.
SYNC_ON=

# Enable Banking (https://enablebanking.com) -- PSD2 open banking API.
APP_ID=
# The key's content, newlines written as \n.
PRIVATE_KEY=

# Supabase project.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Gemini API key, used to auto-categorize transactions and detect subscriptions.
# Recommended. Without it, only your own category rules run.
GEMINI_API_KEY=

# Your login, created by the installer (USER_ID is its Supabase auth user id).
USER_ID=
LOGIN_EMAIL=

# Web Push VAPID keys, for "worth it?" notifications. Generate with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional. The dashboard registers its own address when you sign in.
# Kept as an extra allowed address for the Edge Functions' FRONTEND_URL secret.
FRONTEND_URL=

# The dashboard's build values (see alopex-web/.env.example).
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_VAPID_PUBLIC_KEY=

